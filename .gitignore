# =========================================
# ✅ Python / Flask Project .gitignore
# =========================================

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.env
.venv
env/
ENV/
env.bak/
venv.bak/
flask-project-env/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Package distributions
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Migrations cache (not the actual migration scripts)
migrations/__pycache__/
migrations/*.pyc

# Documentation builds
docs/_build/
site/

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Jupyter/IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

# Python environment/version managers
.python-version
.pdm.toml
.pdm-python
.pdm-build/

# pipenv/poetry (uncomment if used)
# Pipfile.lock
# poetry.lock

# Type checkers
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
dmypy.json

# Cython debug symbols
cython_debug/

# Spyder / Rope
.spyderproject/
.spyproject/
.ropeproject/

# PyBuilder
.pybuilder/
target/

# SageMath
*.sage.py

# Custom files (optional cleanup)
*.sqlite3
*.sqlite3-journal
*.log
*.bak
*.tmp

# =========================================
# 🔒 DO NOT TRACK THESE FILE TYPES/FOLDERS
# =========================================
